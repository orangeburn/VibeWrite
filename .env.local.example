# OpenAI API Configuration
# 从以下地址获取 API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# 模型配置
# Planning Model: 用于复杂推理任务 (意图分析、蓝图生成、审计)
OPENAI_PLANNING_MODEL=gpt-4o

# Writing Model: 用于内容生成 (更快、更经济)
OPENAI_WRITING_MODEL=gpt-4o-mini

# ============================================
# DeepSeek 配置 (如果使用 DeepSeek)
# ============================================
# 取消下面这些行的注释以使用 DeepSeek
# OPENAI_API_KEY=sk-your-deepseek-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_PLANNING_MODEL=deepseek-reasoner
# OPENAI_WRITING_MODEL=deepseek-chat

# Tavily Search API (用于联网搜索功能)
# 从以下地址获取 API Key: https://tavily.com/
TAVILY_API_KEY=tvly-your-api-key-here

# 使用说明:
# 1. 复制此文件并重命名为 .env.local
# 2. 将上面的 API Key 替换为您的真实 Key
# 3. 根据需要调整模型名称
# 4. 重启开发服务器: npm run dev
# 5. .env.local 文件已在 .gitignore 中,不会上传到 GitHub
